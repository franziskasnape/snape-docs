{
  "name": "snape-docs",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "snape-docs", "database_id": "local-only-replace-on-deploy", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "snape-docs-images" }
  ]
}
