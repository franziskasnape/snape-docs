{
  "name": "snape-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Document generator for Snape Art Conservation (offers first; invoices and reports later)",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:query": "wrangler d1 execute DB --local --command",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "backup": "node scripts/backup.mjs",
    "seed:snippets": "node scripts/seed-snippets.mjs",
    "restore": "node scripts/restore.mjs",
    "backup:auto": "node scripts/autobackup.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "fonts": "node scripts/install-fonts.mjs",
    "test": "vitest run --config vitest.config.js",
    "test:layout": "vitest run --config vitest.layout.config.js"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@vivliostyle/core": "^2.45.2",
    "node-html-parser": "^9.0.4",
    "pagedjs": "^0.4.3",
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.0.0"
  }
}
